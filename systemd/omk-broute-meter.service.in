[Unit]
Description=OMK B-route meter
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=15min
StartLimitBurst=5

[Service]
Type=simple
User=@OMK_USER@
Group=@OMK_GROUP@
WorkingDirectory=@OMK_ROOT@/services/broute-meter
Environment=TZ=Asia/Tokyo
ExecStart=@OMK_ROOT@/services/broute-meter/.venv/bin/python -m broute_meter run
Restart=on-failure
RestartSec=60s
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
