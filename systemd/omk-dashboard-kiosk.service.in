[Unit]
Description=OMK dashboard kiosk
After=default.target

[Service]
Type=simple
Environment=WAYLAND_DISPLAY=@WAYLAND_DISPLAY@
Environment=XDG_RUNTIME_DIR=/run/user/@OMK_UID@
ExecStartPre=/bin/sh -c 'until [ -S /run/user/@OMK_UID@/@WAYLAND_DISPLAY@ ]; do sleep 2; done'
ExecStartPre=/bin/sh -c 'until curl -fsS @DASHBOARD_HEALTH_URL@ >/dev/null; do sleep 2; done'
ExecStart=@CHROMIUM_PATH@ --kiosk --user-data-dir=@KIOSK_PROFILE_DIRECTORY@ --no-first-run --no-default-browser-check --noerrdialogs --disable-session-crashed-bubble --password-store=basic --ozone-platform=wayland @DASHBOARD_URL@display
ExecStartPost=/bin/sh -c 'sleep 2; @WTYPE_PATH@ -M alt -M logo -P h'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
