[Unit]
Description=OMK system manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@OMK_USER@
Group=@OMK_GROUP@
WorkingDirectory=@OMK_ROOT@/services/system-manager
EnvironmentFile=@ENV_FILE@
Environment=OMK_BROUTE_CREDENTIALS_PATH=@OMK_ROOT@/services/broute-meter/config/credentials.yaml
Environment=OMK_BROUTE_STATUS_PATH=@OMK_ROOT@/data/broute-meter/status.json
Environment=OMK_BROUTE_RETRY_REQUEST_PATH=@OMK_ROOT@/data/broute-meter/retry-request
Environment=OMK_SITE_UUID_PATH=@OMK_ROOT@/data/site/site_uuid
Environment=OMK_SYSTEMCTL_PATH=@SYSTEMCTL_PATH@
Environment=PYTHONPATH=@OMK_ROOT@/services/system-manager/src
Environment=TZ=Asia/Tokyo
ExecStart=@OMK_ROOT@/services/system-manager/.venv/bin/uvicorn omk_system_manager.main:app --host 0.0.0.0 --port 8788
Restart=always
RestartSec=5
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@OMK_ROOT@/services/broute-meter/config @OMK_ROOT@/data/broute-meter @OMK_ROOT@/data/site

[Install]
WantedBy=multi-user.target
