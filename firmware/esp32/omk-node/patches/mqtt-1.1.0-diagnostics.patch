+/* Registration uses the same bounded outbox as normal data, reserving its
+ * existing control allowance. Caller never waits for a socket or API mutex. */
+int esp_mqtt_client_publish_bounded(esp_mqtt_client_handle_t client,
+    const char *topic, const char *data, int len, int qos, int retain, unsigned limit)
+{
+    return esp_mqtt_client_enqueue_bounded(client, topic, data, len, qos, retain, limit, NULL);
+}
+
+/* OMK uses MQTT 3.1.1. Build the normal SUBSCRIBE packet but leave it QUEUED:
+ * the existing MQTT task sends/retries it and processes SUBACK/expiry. */
+int esp_mqtt_client_subscribe_bounded(esp_mqtt_client_handle_t client,
+    const char *topic, int qos, unsigned limit)
+{
+    if (!client || !topic || !topic[0] || qos < 0 || qos > 2) return -1;
+    if (xSemaphoreTakeRecursive(client->api_lock, 0) != pdTRUE) {
+        network_diag_rejected(ND_MQTT_BUSY);
+        return -3;
+    }
+    int result = -1;
+    if (client->state != MQTT_STATE_CONNECTED ||
+        client->mqtt_state.connection.information.protocol_ver != MQTT_PROTOCOL_V_3_1_1)
+        goto done;
+    size_t required = strlen(topic) + 10; /* header, packet ID, length, qos */
+    size_t used = outbox_get_size(client->outbox);
+    if (used > limit || required > limit - used) {
+        network_diag_rejected(ND_MQTT_CAPACITY);
+        result = -2; goto done;
+    }
+    mqtt_reset_pending_message(client);
+    esp_mqtt_topic_t filter = {.filter = topic, .qos = qos};
+    mqtt_msg_subscribe(&client->mqtt_state.connection, &filter, 1,
+                      &client->mqtt_state.pending_msg_id);
+    if (!client->mqtt_state.connection.outbound_message.length) goto done;
+    client->mqtt_state.pending_msg_type = MQTT_MSG_TYPE_SUBSCRIBE;
+    if (mqtt_enqueue(client, NULL, 0)) result = client->mqtt_state.pending_msg_id;
+done:
+    MQTT_API_UNLOCK(client);
+    return result;
+}
+
+/* The caller callback runs before releasing MQTT ownership: a PUBACK cannot
+ * overtake installation of its packet ID. Never call MQTT from the callback. */
+int esp_mqtt_client_enqueue_bounded(esp_mqtt_client_handle_t client,
+    const char *topic, const char *data, int len, int qos, int retain,
+    unsigned limit, void (*submitted)(int))
+{
+    if (!client || !topic || !data || len < 0) return -1;
+#ifndef MQTT_DISABLE_API_LOCKS
+    if (xSemaphoreTakeRecursive(client->api_lock, 0) != pdTRUE) {
+        network_diag_rejected(ND_MQTT_BUSY);
+        return -3;
+    }
+#else
+#error "OMK bounded enqueue requires MQTT API locks"
+#endif
+    if (!len) len = strlen(data);
+    /* MQTT 3.1.1: fixed header up to 5, topic length 2, packet ID up to 2.
+     * Check under the SAME mutex as insertion, including QoS 0 and headers. */
+    size_t required = (size_t)len + strlen(topic) + 9;
+    int result = -2;
+    size_t used = outbox_get_size(client->outbox);
+    if (used <= limit && required <= limit - used)
+        result = esp_mqtt_client_enqueue(client, topic, data, len, qos, retain, true);
+    else network_diag_rejected(ND_MQTT_CAPACITY);
+    if (submitted) submitted(result);
+    xSemaphoreGiveRecursive(client->api_lock);
+    return result;
+}
+
+int esp_mqtt_client_get_outbox_size_nowait(esp_mqtt_client_handle_t client)
+{
+    if (!client) return 0;
+    if (xSemaphoreTakeRecursive(client->api_lock, 0) != pdTRUE) return -3;
+    int size = esp_mqtt_client_get_outbox_size(client);
+    xSemaphoreGiveRecursive(client->api_lock);
+    return size;
+}
+
+/* Diagnostics share the ordinary-data allowance, leaving control headroom. */
+int esp_mqtt_client_enqueue_diagnostic(esp_mqtt_client_handle_t client,
+                                       const char *topic, const char *data)
+{
+    return esp_mqtt_client_enqueue_bounded(client, topic, data, 0, 0, 0,
+                                           OMK_MQTT_DATA_BYTES, NULL);
 }
 
