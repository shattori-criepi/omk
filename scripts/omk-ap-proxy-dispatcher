#!/usr/bin/env bash
# Restore AP-only socket listeners after NetworkManager recreates wlan0.
set -euo pipefail

readonly INTERFACE="wlan0"
readonly CONNECTION="omk-ap"
readonly ADDRESS="192.168.50.1/24"

interface="${1:-}"
action="${2:-}"

# NetworkManager emits `up` after activation. Ignore all other transitions so
# link noise cannot expose the loopback backends through a FreeBind socket.
[[ "${interface}" == "${INTERFACE}" && "${action}" == "up" ]] || exit 0
[[ "$(nmcli -g GENERAL.CONNECTION device show "${INTERFACE}" 2>/dev/null || true)" == "${CONNECTION}" ]] || exit 0

# Do not rely on FreeBind during recovery: the AP address must exist first.
ip -4 -o address show dev "${INTERFACE}" scope global 2>/dev/null |
  awk -v address="${ADDRESS}" '$3 == "inet" && $4 == address { found = 1 } END { exit !found }' || exit 0

exec systemctl start omk-mqtt-ap-proxy.socket omk-dashboard-ap-proxy.socket
