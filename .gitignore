.env
.env.*
__pycache__/
*.pyc
*.egg-info/
.vscode/
.DS_Store

# Runtime measurement data is ignored; only documentation and placeholders
# that preserve the standard directory layout are tracked.
data/*
!data/README.md
!data/.gitkeep
!data/broute/
data/broute/*
!data/broute/.gitkeep
!data/sensors/
data/sensors/*
!data/sensors/.gitkeep
!data/latest/
data/latest/*
!data/latest/.gitkeep
!data/database/
data/database/*
!data/database/.gitkeep
!data/exports/
data/exports/*
!data/exports/.gitkeep
!data/harvest-uploader/
data/harvest-uploader/*
!data/harvest-uploader/.gitkeep
logs/

# Mosquitto runtime persistence data
services/mosquitto/data/*
!services/mosquitto/data/.gitkeep
secrets/
config/omk-ap.env
firmware/esp32/sen66-node/src/network_config.h

# Even terminal logs
even-terminal-*.log
