.env
.env.*
!services/harvest-uploader/.env.example

# Python development and test output
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Embedded build output and downloaded managed dependencies
.pio/
managed_components/
sdkconfig.*-wifi-set

# KiCad local state and generated inspection output
.cache/
.history/
*-backups/
*.kicad_prl
*.kicad_prl-bak
*.lck
*.blank.kicad_sch
*.generated.kicad_sch
erc-report.txt
rendered/
fp-info-cache

.vscode/
.DS_Store

# Runtime measurement data is ignored; only documentation and placeholders
# that preserve the standard directory layout are tracked.
data/*
!data/README.md
!data/.gitkeep
!data/broute-meter/
data/broute-meter/*
!data/broute-meter/.gitkeep
!data/sensors/
data/sensors/*
!data/sensors/.gitkeep
!data/latest/
data/latest/*
!data/latest/.gitkeep
!data/dashboard/
data/dashboard/*
!data/dashboard/.gitkeep
!data/processed/
data/processed/*
!data/processed/.gitkeep
!data/errors/
!data/errors/transform/
data/errors/transform/*
!data/errors/transform/.gitkeep
!data/harvest-uploader/
data/harvest-uploader/*
!data/harvest-uploader/.gitkeep
logs/

# Mosquitto runtime persistence data
services/mosquitto/data/*
!services/mosquitto/data/.gitkeep
secrets/
config/omk-ap.env

# Even terminal logs
even-terminal-*.log
data/provisioning/nodes/
firmware/esp32/omk-node/src/development_wifi_config.h
