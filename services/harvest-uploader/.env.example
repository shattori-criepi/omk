# MQTT broker.  This client is independent from sensor-collector.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_CLIENT_ID=omk-harvest-uploader
MQTT_TOPIC=omk/#

# SORACOM Harvest Data endpoint; do not put API keys in this file or payloads.
HARVEST_ENDPOINT=http://harvest.soracom.io
HARVEST_TIMEOUT_SECONDS=10
HARVEST_RETRY_MAX_AGE_SECONDS=3600
HARVEST_QUEUE_PATH=/app/data/harvest-uploader/queue.sqlite3
TZ=Asia/Tokyo
